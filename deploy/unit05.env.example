# Add non-secret values to /workspace/.env on a Vast instance.
UNIT05_ROOT=/workspace/unit05/data
UNIT05_COMFY_URL=http://127.0.0.1:18188
UNIT05_COMFY_ROOT=/workspace/ComfyUI
UNIT05_COMFY_INPUT_DIR=/workspace/input
UNIT05_COMFY_OUTPUT_DIR=/workspace/output
UNIT05_TEMPLATE=/workspace/unit05/templates/dasiwa_ref2va_api_template.json
UNIT05_HOST=127.0.0.1
UNIT05_PORT=18765

# Configure either a mounted/local destination:
# UNIT05_OUTPUT_LOCAL_DIR=/workspace/render-return

# Or the editor desktop over Tailscale + SFTP:
# For userspace Tailscale, the local bridge forwards 127.0.0.1:10022.
UNIT05_EDITOR_TAILSCALE_HOST=100.76.35.4
UNIT05_OUTPUT_SFTP_HOST=127.0.0.1
UNIT05_OUTPUT_SFTP_PORT=10022
UNIT05_OUTPUT_SFTP_USER=Milo
UNIT05_OUTPUT_SFTP_KEY=/workspace/secrets/unit05-output-ed25519
UNIT05_OUTPUT_SFTP_DIR=/D:/incomingfrom05

# The container binds both services on all interfaces; expose them only through
# Vast's authenticated proxy, an SSH tunnel, or Tailscale.
COMFYUI_HOST=0.0.0.0
COMFYUI_PORT=8188
UNIT05_HOST=0.0.0.0
UNIT05_PORT=18765

# Persistent volume mount points used by the image.
UNIT05_ROOT=/workspace/unit05-data
UNIT05_COMFY_URL=http://127.0.0.1:8188
UNIT05_COMFY_ROOT=/workspace/ComfyUI
UNIT05_COMFY_INPUT_DIR=/workspace/ComfyUI/input
UNIT05_COMFY_OUTPUT_DIR=/workspace/ComfyUI/output
UNIT05_TEMPLATE=/opt/unit05/templates/dasiwa_ref2va_api_template.json

# Leave delivery unset until the editor endpoint and a restricted key are
# mounted. Completed work remains in Unit05's outbox and is retried later.
# UNIT05_OUTPUT_SFTP_HOST=editor.tailnet-name.ts.net
# UNIT05_OUTPUT_SFTP_PORT=22
# UNIT05_OUTPUT_SFTP_USER=unit05delivery
# UNIT05_OUTPUT_SFTP_KEY=/run/secrets/editor-output-key
# UNIT05_OUTPUT_SFTP_DIR=/D:/incomingfromunit05
